---
import HeroMedia from './HeroMedia.astro'
import {ratioOf} from '../lib/image'

interface Props {
  slides: {
    _key?: string
    image?: {asset?: {_ref?: string}}
    video?: {asset?: {url?: string; mimeType?: string}}
    alt?: string
    caption?: string
  }[]
}

const {slides} = Astro.props
const many = slides.length > 1
---

<div class="gallery" data-gallery>
  <div class="grail" data-rail tabindex="0" role="region" aria-label="Opening gallery">
    {
      slides.map((s) => (
        <div class="gslide" data-slide>
          <HeroMedia
            image={s.image}
            video={s.video}
            alt={s.alt ?? ''}
            width={1400}
            ratio={ratioOf(s.image, '2 / 3')}
          />
          {s.caption && <div class="gcap m dimmer">{s.caption}</div>}
        </div>
      ))
    }
  </div>

  {
    many && (
      <div class="gbar">
        <button type="button" data-prev aria-label="Previous picture">←</button>
        <button type="button" data-next aria-label="Next picture">→</button>
        <span class="n" data-counter>
          01 / {String(slides.length).padStart(2, '0')}
        </span>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const rail = gallery.querySelector<HTMLElement>('[data-rail]')
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')]
    const counter = gallery.querySelector<HTMLElement>('[data-counter]')
    if (!rail || slides.length < 2) return

    const pad = (n: number) => String(n).padStart(2, '0')

    // Slides are different widths, so "which one am I on" is whichever sits
    // nearest the left edge of the viewport rather than a fixed page number.
    const nearest = () => {
      let best = 0
      let bestGap = Infinity
      slides.forEach((s, i) => {
        const gap = Math.abs(s.offsetLeft - rail.scrollLeft)
        if (gap < bestGap) {
          bestGap = gap
          best = i
        }
      })
      return best
    }

    const sync = () => {
      if (counter) counter.textContent = `${pad(nearest() + 1)} / ${pad(slides.length)}`
    }

    let frame = 0
    rail.addEventListener('scroll', () => {
      cancelAnimationFrame(frame)
      frame = requestAnimationFrame(sync)
    })

    const go = (step: number) => {
      const target = slides[Math.min(slides.length - 1, Math.max(0, nearest() + step))]
      rail.scrollTo({left: target.offsetLeft, behavior: 'smooth'})
    }

    gallery.querySelector('[data-next]')?.addEventListener('click', () => go(1))
    gallery.querySelector('[data-prev]')?.addEventListener('click', () => go(-1))

    sync()
  })
</script>
