---
import {getHomePage} from '../lib/sanity'

const home = await getHomePage()
const trackUrl = home?.track?.asset?.url

const TRACK = 'https://soundcloud.com/trapsupraz/endlesssunsets'
const EMBED =
  'https://w.soundcloud.com/player/?url=' +
  encodeURIComponent(TRACK) +
  '&auto_play=true&visual=false&show_teaser=false&hide_related=true&show_comments=false&show_user=false'

const COLOURS = ['--vermilion', '--mustard', '--forest', '--lavender', '--cobalt', '--fluor', '--sage']
const BARS = 16
const restOf = (i: number) => (0.2 + ((i * 37) % 11) / 17).toFixed(2)
const durOf = (i: number) => (0.7 + ((i * 53) % 13) / 15).toFixed(2)
const delayOf = (i: number) => (((i * 29) % 17) / 21).toFixed(2)
---

<div class="vinyl" data-vinyl data-playing="true" data-mode={trackUrl ? 'file' : 'embed'}>
  <div class="djpanel">
    <div class={`viz ${trackUrl ? 'live' : 'demo'}`} data-viz aria-hidden="true">
      {
        Array.from({length: BARS}, (_, i) => (
          <i
            style={`background:var(${COLOURS[i % COLOURS.length]});--rest:${restOf(i)};animation-duration:${durOf(i)}s;animation-delay:${delayOf(i)}s`}
          />
        ))
      }
    </div>

    <label class="fader">
      <span class="lbl"><span>Vol</span><span data-volout>80</span></span>
      <input type="range" min="0" max="100" value="80" data-vol aria-label="Volume" />
    </label>

    {
      trackUrl && (
        <label class="fader">
          <span class="lbl"><span>LPF</span><span data-filtout>Open</span><span>HPF</span></span>
          <input
            type="range"
            min="-100"
            max="100"
            value="0"
            data-filter
            aria-label="Filter: low pass to high pass"
          />
        </label>
      )
    }
  </div>

  <button class="vinylbtn" type="button" data-toggle aria-pressed="true" aria-label="Pause music">
    <span class="scene">
      <span class="deck">
        <span class="record"><span class="rlabel"></span></span>
        <span class="arm"></span>
        <span class="knob k1"></span><span class="knob k2"></span>
      </span>
      <span class="lid"><span class="lidmark">MIGU.</span></span>
    </span>
  </button>

  <span class="vinylstate m" data-state aria-hidden="true">PLAYING</span>

  {
    trackUrl ? (
      <audio data-audio src={trackUrl} crossorigin="anonymous" loop preload="auto" />
    ) : (
      <iframe
        class="scframe"
        data-sc
        src={EMBED}
        title="SoundCloud player"
        allow="autoplay"
        tabindex="-1"
        aria-hidden="true"
        scrolling="no"
        frameborder="no"
      />
    )
  }
</div>

{!trackUrl && <script is:inline src="https://w.soundcloud.com/player/api.js" />}

<script is:inline>
  (function () {
    var root = document.querySelector('[data-vinyl]')
    if (!root) return

    var button = root.querySelector('[data-toggle]')
    var stateEl = root.querySelector('[data-state]')
    var viz = root.querySelector('[data-viz]')
    var bars = viz ? Array.prototype.slice.call(viz.children) : []
    var volIn = root.querySelector('[data-vol]')
    var volOut = root.querySelector('[data-volout]')
    var filtIn = root.querySelector('[data-filter]')
    var filtOut = root.querySelector('[data-filtout]')
    var KEY = 'migu-player'

    function paint(playing) {
      root.setAttribute('data-playing', String(playing))
      button.setAttribute('aria-pressed', String(playing))
      button.setAttribute('aria-label', playing ? 'Pause music' : 'Play music')
      if (stateEl) stateEl.textContent = playing ? 'PLAYING' : 'PAUSED'
      if (viz) viz.classList.toggle('still', !playing)
    }

    function remember(patch) {
      try {
        var prev = JSON.parse(sessionStorage.getItem(KEY) || '{}')
        sessionStorage.setItem(KEY, JSON.stringify(Object.assign(prev, patch)))
      } catch (e) {}
    }

    function recall() {
      try {
        return JSON.parse(sessionStorage.getItem(KEY) || '{}')
      } catch (e) {
        return {}
      }
    }

    function onFirstGesture(fn) {
      var go = function (e) {
        // A click on the player itself belongs to the button. Acting on it here
        // too would start the track and then immediately toggle it back off.
        if (e && e.target && e.target.closest && e.target.closest('[data-vinyl]')) return
        window.removeEventListener('pointerdown', go)
        window.removeEventListener('keydown', go)
        fn()
      }
      window.addEventListener('pointerdown', go)
      window.addEventListener('keydown', go)
    }

    var saved = recall()
    if (volIn && typeof saved.volume === 'number') volIn.value = String(saved.volume)
    if (volOut && volIn) volOut.textContent = volIn.value

    if (root.dataset.mode === 'file') fileMode()
    else embedMode()

    /* ---------- self-hosted file: real analyser, real filter ---------- */
    function fileMode() {
      var audio = root.querySelector('[data-audio]')
      var ctx = null
      var gain = null
      var filter = null
      var analyser = null
      var data = null
      var corsOk = true
      var graphed = false
      var wanted = false

      if (saved.position) {
        audio.addEventListener('loadedmetadata', function () {
          try {
            audio.currentTime = saved.position
          } catch (e) {}
        })
      }

      // Web Audio can only touch the track if the file came back with CORS
      // headers. Without them the browser hands us a silent stream, so the
      // analyser and filter step aside rather than muting the music.
      function degrade() {
        if (viz) {
          viz.classList.remove('live')
          viz.classList.add('demo')
        }
        if (filtIn && filtIn.parentElement) filtIn.parentElement.hidden = true
      }

      audio.addEventListener('error', function () {
        if (!corsOk) return
        // Sanity's asset CDN 403s a cross-origin request unless this site's
        // origin is on the project's CORS list. Retry as a plain request so
        // the music at least plays.
        corsOk = false
        audio.removeAttribute('crossorigin')
        audio.load()
        degrade()
        if (wanted) audio.play().catch(function () { paint(false) })
      })

      function buildGraph() {
        if (graphed) return !!ctx
        graphed = true
        if (!corsOk) return false
        var AC = window.AudioContext || window.webkitAudioContext
        if (!AC) return false
        try {
          ctx = new AC()
          var src = ctx.createMediaElementSource(audio)
          filter = ctx.createBiquadFilter()
          filter.type = 'lowpass'
          filter.frequency.value = 22050
          gain = ctx.createGain()
          analyser = ctx.createAnalyser()
          analyser.fftSize = 64
          analyser.smoothingTimeConstant = 0.72
          data = new Uint8Array(analyser.frequencyBinCount)
          src.connect(filter)
          filter.connect(gain)
          gain.connect(analyser)
          analyser.connect(ctx.destination)
          applyVolume()
          applyFilter()
          requestAnimationFrame(draw)
          return true
        } catch (e) {
          ctx = null
          degrade()
          return false
        }
      }

      function draw() {
        requestAnimationFrame(draw)
        if (!analyser || root.getAttribute('data-playing') !== 'true') return
        analyser.getByteFrequencyData(data)
        for (var i = 0; i < bars.length; i++) {
          var v = data[Math.floor((i * data.length) / bars.length)] / 255
          bars[i].style.transform = 'scaleY(' + Math.max(0.06, v) + ')'
        }
      }

      function applyVolume() {
        var v = Number(volIn ? volIn.value : 80) / 100
        if (gain) gain.gain.value = v
        else audio.volume = v
      }

      // One slider, detented in the middle: left rolls a low pass down, right
      // pushes a high pass up, centre stays out of the way.
      function applyFilter() {
        if (!filter || !filtIn) return
        var v = Number(filtIn.value)
        if (Math.abs(v) < 4) {
          filter.type = 'lowpass'
          filter.frequency.value = 22050
          if (filtOut) filtOut.textContent = 'Open'
          return
        }
        if (v < 0) {
          filter.type = 'lowpass'
          var lp = Math.round(22050 * Math.pow(200 / 22050, -v / 100))
          filter.frequency.value = lp
          if (filtOut) filtOut.textContent = lp >= 1000 ? (lp / 1000).toFixed(1) + 'k' : String(lp)
          return
        }
        filter.type = 'highpass'
        var hp = Math.round(20 * Math.pow(2000 / 20, v / 100))
        filter.frequency.value = hp
        if (filtOut) filtOut.textContent = hp >= 1000 ? (hp / 1000).toFixed(1) + 'k' : String(hp)
      }

      // The audio graph is only built from inside a real user gesture. An
      // AudioContext created before one stays suspended, and a media element
      // wired into a suspended context plays to nobody.
      function start(byUser) {
        wanted = true
        if (byUser) {
          buildGraph()
          if (ctx && ctx.state === 'suspended') ctx.resume()
        }
        var p = audio.play()
        if (p && p.catch) {
          p.catch(function () {
            paint(false)
            onFirstGesture(function () {
              start(true)
            })
          })
        }
      }

      audio.addEventListener('play', function () {
        paint(true)
        remember({playing: true})
      })
      audio.addEventListener('pause', function () {
        paint(false)
        remember({playing: false})
      })
      audio.addEventListener('timeupdate', function () {
        remember({position: audio.currentTime})
      })

      if (volIn) {
        volIn.addEventListener('input', function () {
          applyVolume()
          if (volOut) volOut.textContent = volIn.value
          remember({volume: Number(volIn.value)})
        })
      }
      if (filtIn) filtIn.addEventListener('input', applyFilter)

      button.addEventListener('click', function () {
        if (root.getAttribute('data-playing') === 'true') {
          wanted = false
          audio.pause()
        } else {
          start(true)
        }
      })

      if (saved.playing === false) paint(false)
      else start(false)
    }

    /* ---------- SoundCloud embed: volume only ---------- */
    function embedMode() {
      var frame = root.querySelector('[data-sc]')
      if (typeof SC === 'undefined' || !SC.Widget) {
        root.hidden = true
        return
      }
      var widget = SC.Widget(frame)
      var playing = false

      widget.bind(SC.Widget.Events.READY, function () {
        widget.setVolume(Number(volIn ? volIn.value : 80))
        if (saved.position) widget.seekTo(saved.position)
        if (saved.playing === false) {
          widget.pause()
          paint(false)
          return
        }
        widget.play()
        setTimeout(function () {
          if (playing) return
          paint(false)
          onFirstGesture(function () {
            widget.play()
          })
        }, 1200)
      })

      widget.bind(SC.Widget.Events.PLAY, function () {
        playing = true
        paint(true)
        remember({playing: true})
      })
      widget.bind(SC.Widget.Events.PAUSE, function () {
        playing = false
        paint(false)
        remember({playing: false})
      })

      var last = 0
      widget.bind(SC.Widget.Events.PLAY_PROGRESS, function (e) {
        var now = Date.now()
        if (now - last < 1000) return
        last = now
        remember({position: e.currentPosition})
      })

      if (volIn) {
        volIn.addEventListener('input', function () {
          widget.setVolume(Number(volIn.value))
          if (volOut) volOut.textContent = volIn.value
          remember({volume: Number(volIn.value)})
        })
      }

      button.addEventListener('click', function () {
        if (playing) widget.pause()
        else widget.play()
      })
    }
  })()
</script>
