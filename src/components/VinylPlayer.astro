---
import {getHomePage} from '../lib/sanity'

const home = await getHomePage()

// The playlist: song 1 from the studio's original track field, then the "More songs" list.
// Each title is what scrolls across the panel: the studio's "Now playing" text, else a tidied file name.
// (In SoundCloud mode the script swaps in the track's own title once the widget is ready.)
const tidy = (name?: string) => name?.replace(/\.[a-z0-9]+$/i, '').replace(/_/g, ' ') ?? ''
const tracks = [
  ...(home?.track?.asset?.url
    ? [{src: home.track.asset.url, title: home.trackTitle?.trim() || tidy(home.track.asset.originalFilename)}]
    : []),
  ...(home?.tracks ?? []).filter((t) => t.url).map((t) => ({src: t.url!, title: t.title?.trim() || tidy(t.originalFilename)})),
]
const trackUrl = tracks[0]?.src
const nowPlaying = tracks[0]?.title ?? ''
const many = tracks.length > 1

const TRACK = 'https://soundcloud.com/trapsupraz/endlesssunsets'
const EMBED =
  'https://w.soundcloud.com/player/?url=' +
  encodeURIComponent(TRACK) +
  '&auto_play=false&visual=false&show_teaser=false&hide_related=true&show_comments=false&show_user=false'

const COLOURS = ['--vermilion', '--mustard', '--forest', '--lavender', '--cobalt', '--fluor', '--sage']
const BARS = 16
const restOf = (i: number) => (0.2 + ((i * 37) % 11) / 17).toFixed(2)
const durOf = (i: number) => (0.7 + ((i * 53) % 13) / 15).toFixed(2)
const delayOf = (i: number) => (((i * 29) % 17) / 21).toFixed(2)
---

<div class="vinyl" data-vinyl data-playing="false" data-mode={trackUrl ? 'file' : 'embed'}>
  <div class="djpanel" data-panel inert>
    <div class="nprow">
      {many && <button class="skip" type="button" data-prev aria-label="Previous song">‹</button>}
      <div class="ticker" data-ticker hidden={!nowPlaying}>
        <span class="visually-hidden" data-np-label aria-live="polite">Now playing: {nowPlaying}</span>
        <span class="run" aria-hidden="true">
          <span data-np>{nowPlaying}</span><span data-np>{nowPlaying}</span>
        </span>
      </div>
      {many && <button class="skip" type="button" data-next aria-label="Next song">›</button>}
    </div>
    <div class={`viz still ${trackUrl ? 'live' : 'demo'}`} data-viz aria-hidden="true">
      {
        Array.from({length: BARS}, (_, i) => (
          <i
            style={`background:var(${COLOURS[i % COLOURS.length]});--rest:${restOf(i)};animation-duration:${durOf(i)}s;animation-delay:${delayOf(i)}s`}
          />
        ))
      }
    </div>

    <label class="fader">
      <span class="lbl"><span>Vol</span><span data-volout>80</span></span>
      <input type="range" min="0" max="100" value="80" data-vol aria-label="Volume" />
    </label>

    {
      trackUrl && (
        <label class="fader">
          <span class="lbl"><span>LPF</span><span data-filtout>Open</span><span>HPF</span></span>
          <input
            type="range"
            min="-100"
            max="100"
            value="0"
            data-filter
            aria-label="Filter: low pass to high pass"
          />
        </label>
      )
    }
  </div>

  <button class="vinylbtn" type="button" data-toggle aria-pressed="false" aria-label="Play music">
    <span class="scene">
      <span class="deck">
        <span class="record"><span class="rlabel"></span></span>
        <span class="arm"></span>
        <span class="knob k1"></span><span class="knob k2"></span>
      </span>
      <span class="lid"><span class="lidmark">MIGU.</span></span>
      <span class="cd" aria-hidden="true"></span>
    </span>
  </button>

  <span class="vinylstate m" data-state aria-hidden="true">PLAY</span>

  {
    trackUrl ? (
      <audio
        data-audio
        data-tracks={JSON.stringify(tracks)}
        src={trackUrl}
        crossorigin="anonymous"
        loop={!many}
        preload="auto"
      />
    ) : (
      <iframe
        class="scframe"
        data-sc
        src={EMBED}
        title="SoundCloud player"
        allow="autoplay"
        tabindex="-1"
        aria-hidden="true"
        scrolling="no"
        frameborder="no"
      />
    )
  }
</div>

{!trackUrl && <script is:inline src="https://w.soundcloud.com/player/api.js" />}

<script is:inline>
  (function () {
    var root = document.querySelector('[data-vinyl]')
    if (!root) return

    var button = root.querySelector('[data-toggle]')
    var panel = root.querySelector('[data-panel]')
    var stateEl = root.querySelector('[data-state]')
    var viz = root.querySelector('[data-viz]')
    var bars = viz ? Array.prototype.slice.call(viz.children) : []
    var volIn = root.querySelector('[data-vol]')
    var volOut = root.querySelector('[data-volout]')
    var filtIn = root.querySelector('[data-filter]')
    var filtOut = root.querySelector('[data-filtout]')
    var KEY = 'migu-player'
    var ticker = root.querySelector('[data-ticker]')

    // Scrolling "now playing" banner. Speed stays constant however long the title is.
    function setNowPlaying(text) {
      if (!ticker || !text) return
      ticker.querySelectorAll('[data-np]').forEach(function (el) {
        el.textContent = text
      })
      var label = ticker.querySelector('[data-np-label]')
      if (label) label.textContent = 'Now playing: ' + text
      ticker.hidden = false
      ticker.style.setProperty('--np-dur', Math.max(6, text.length * 0.32).toFixed(1) + 's')
    }
    if (ticker && !ticker.hidden) setNowPlaying(ticker.querySelector('[data-np]').textContent)

    function paint(playing) {
      root.setAttribute('data-playing', String(playing))
      button.setAttribute('aria-pressed', String(playing))
      button.setAttribute('aria-label', playing ? 'Pause music' : 'Play music')
      if (stateEl) stateEl.textContent = playing ? 'PLAYING' : 'PLAY'
      if (viz) viz.classList.toggle('still', !playing)
      // The sliders only exist while music plays; tucked away they can't take focus.
      if (panel) panel.inert = !playing
    }

    function remember(patch) {
      try {
        var prev = JSON.parse(sessionStorage.getItem(KEY) || '{}')
        sessionStorage.setItem(KEY, JSON.stringify(Object.assign(prev, patch)))
      } catch (e) {}
    }

    function recall() {
      try {
        return JSON.parse(sessionStorage.getItem(KEY) || '{}')
      } catch (e) {
        return {}
      }
    }

    var saved = recall()
    if (volIn && typeof saved.volume === 'number') volIn.value = String(saved.volume)
    if (volOut && volIn) volOut.textContent = volIn.value

    if (root.dataset.mode === 'file') fileMode()
    else embedMode()

    /* ---------- self-hosted file: real analyser, real filter ---------- */
    function fileMode() {
      var audio = root.querySelector('[data-audio]')
      var ctx = null
      var gain = null
      var filter = null
      var analyser = null
      var data = null
      var corsOk = true
      var graphed = false
      var wanted = false
      var tracks = []
      try {
        tracks = JSON.parse(audio.getAttribute('data-tracks') || '[]')
      } catch (e) {}
      var at = typeof saved.track === 'number' && saved.track < tracks.length ? saved.track : 0

      // Back where the visitor left off: same song, same spot.
      if (at > 0) audio.src = tracks[at].src
      if (tracks[at]) setNowPlaying(tracks[at].title)
      if (saved.position) {
        audio.addEventListener(
          'loadedmetadata',
          function () {
            try {
              audio.currentTime = saved.position
            } catch (e) {}
          },
          {once: true},
        )
      }

      /* ---------- deck sounds between songs, synthesised (no files to load) ---------- */
      // With the audio graph up they run through the filter and volume, so the
      // bars dance to them too; otherwise a small context of their own plays them.
      var sfxOwn = null
      function sfxOut() {
        if (ctx && filter) return {c: ctx, out: filter, vol: 1}
        var AC = window.AudioContext || window.webkitAudioContext
        if (!AC) return null
        if (!sfxOwn) sfxOwn = new AC()
        if (sfxOwn.state === 'suspended') sfxOwn.resume()
        return {c: sfxOwn, out: sfxOwn.destination, vol: Number(volIn ? volIn.value : 80) / 100}
      }
      function noise(c, secs, fill) {
        var b = c.createBuffer(1, Math.round(c.sampleRate * secs), c.sampleRate)
        var d = b.getChannelData(0)
        for (var i = 0; i < d.length; i++) d[i] = fill ? fill(i, d) : Math.random() * 2 - 1
        return b
      }
      function amp(o, level) {
        var g = o.c.createGain()
        g.gain.value = level * o.vol
        g.connect(o.out)
        return g
      }

      // Record scratch: noise through a resonant band-pass, swept forward and back
      // like a hand rocking the platter, with a sawtooth riding the same curve.
      function scratch() {
        var o = sfxOut()
        if (!o) return
        var c = o.c
        var t = c.currentTime + 0.01
        var curve = [[0, 260], [0.11, 2600], [0.2, 420], [0.3, 2000], [0.46, 220]]
        var src = c.createBufferSource()
        src.buffer = noise(c, 0.5)
        var bp = c.createBiquadFilter()
        bp.type = 'bandpass'
        bp.Q.value = 7
        var saw = c.createOscillator()
        saw.type = 'sawtooth'
        var sawLp = c.createBiquadFilter()
        sawLp.type = 'lowpass'
        sawLp.frequency.value = 1600
        curve.forEach(function (p, i) {
          var f = i ? 'exponentialRampToValueAtTime' : 'setValueAtTime'
          bp.frequency[f](p[1], t + p[0])
          saw.frequency[f](p[1] / 6, t + p[0])
        })
        var env = c.createGain()
        env.gain.setValueAtTime(0.0001, t)
        env.gain.exponentialRampToValueAtTime(1, t + 0.02)
        env.gain.setValueAtTime(1, t + 0.18)
        env.gain.exponentialRampToValueAtTime(0.5, t + 0.21)
        env.gain.exponentialRampToValueAtTime(1, t + 0.25)
        env.gain.exponentialRampToValueAtTime(0.0001, t + 0.48)
        var sawGain = c.createGain()
        sawGain.gain.value = 0.18
        src.connect(bp).connect(env)
        saw.connect(sawLp).connect(sawGain).connect(env)
        env.connect(amp(o, 0.9))
        src.start(t)
        saw.start(t)
        src.stop(t + 0.5)
        saw.stop(t + 0.5)
      }

      // Run-out groove: faint hiss with sparse pops, looped until the next song lands.
      function crackle() {
        var o = sfxOut()
        if (!o) return function () {}
        var c = o.c
        var pop = 0
        var src = c.createBufferSource()
        src.buffer = noise(c, 2.3, function () {
          if (Math.random() < 0.0005) pop = (Math.random() * 0.7 + 0.3) * (Math.random() < 0.5 ? -1 : 1)
          pop *= 0.86
          return (Math.random() * 2 - 1) * 0.035 + pop
        })
        src.loop = true
        var hp = c.createBiquadFilter()
        hp.type = 'highpass'
        hp.frequency.value = 700
        var g = amp(o, 0.55)
        g.gain.setValueAtTime(0.0001, c.currentTime)
        g.gain.exponentialRampToValueAtTime(0.55 * o.vol || 0.0001, c.currentTime + 0.15)
        src.connect(hp).connect(g)
        src.start()
        return function stop() {
          var n = c.currentTime
          g.gain.cancelScheduledValues(n)
          g.gain.setValueAtTime(g.gain.value || 0.0001, n)
          g.gain.exponentialRampToValueAtTime(0.0001, n + 0.35)
          src.stop(n + 0.4)
        }
      }

      // Needle drop: a sharp tick on top of a soft low thump.
      function click() {
        var o = sfxOut()
        if (!o) return
        var c = o.c
        var src = c.createBufferSource()
        src.buffer = noise(c, 0.09, function (i, d) {
          var k = i / c.sampleRate
          return (Math.random() * 2 - 1) * Math.exp(-k * 90) + Math.sin(k * 2 * Math.PI * 70) * Math.exp(-k * 35) * 0.8
        })
        src.connect(amp(o, 0.8))
        src.start()
      }

      // Switching songs only swaps the element's source. The Web Audio graph is
      // wired to the element, not the file, so the filter and analyser carry on.
      // While it changes: scratch, crackle until the new song is ready, needle drop.
      var switching = false
      var stopCrackle = null
      var swapTimer = 0
      audio.addEventListener('playing', function () {
        if (!stopCrackle && !switching) return
        if (stopCrackle) stopCrackle()
        stopCrackle = null
        switching = false
        click()
      })
      function go(step) {
        if (tracks.length < 2) return
        at = (at + step + tracks.length) % tracks.length
        var playOn = wanted
        switching = playOn
        audio.src = tracks[at].src
        setNowPlaying(tracks[at].title)
        remember({track: at, position: 0})
        if (!playOn) return
        clearTimeout(swapTimer)
        if (!stopCrackle) scratch()
        // Let the scratch finish before the new song comes in.
        swapTimer = setTimeout(function () {
          if (!switching) return
          if (!stopCrackle) stopCrackle = crackle()
          var p = audio.play()
          if (p && p.catch) {
            p.catch(function () {
              if (stopCrackle) stopCrackle()
              stopCrackle = null
              switching = false
            })
          }
        }, 450)
      }
      audio.addEventListener('ended', function () {
        go(1)
      })
      var prevBtn = root.querySelector('[data-prev]')
      var nextBtn = root.querySelector('[data-next]')
      if (prevBtn) prevBtn.addEventListener('click', function () { go(-1) })
      if (nextBtn) nextBtn.addEventListener('click', function () { go(1) })
      root.addEventListener('keydown', function (e) {
        if (e.target && e.target.type === 'range') return // arrows move the sliders there
        if (e.key === 'ArrowRight') go(1)
        else if (e.key === 'ArrowLeft') go(-1)
      })

      // Web Audio can only touch the track if the file came back with CORS
      // headers. Without them the browser hands us a silent stream, so the
      // analyser and filter step aside rather than muting the music.
      function degrade() {
        if (viz) {
          viz.classList.remove('live')
          viz.classList.add('demo')
        }
        if (filtIn && filtIn.parentElement) filtIn.parentElement.hidden = true
      }

      audio.addEventListener('error', function () {
        if (!corsOk) return
        // Sanity's asset CDN 403s a cross-origin request unless this site's
        // origin is on the project's CORS list. Retry as a plain request so
        // the music at least plays.
        corsOk = false
        audio.removeAttribute('crossorigin')
        audio.load()
        degrade()
        if (wanted) audio.play().catch(function () { paint(false) })
      })

      function buildGraph() {
        if (graphed) return !!ctx
        graphed = true
        if (!corsOk) return false
        var AC = window.AudioContext || window.webkitAudioContext
        if (!AC) return false
        try {
          ctx = new AC()
          var src = ctx.createMediaElementSource(audio)
          filter = ctx.createBiquadFilter()
          filter.type = 'lowpass'
          filter.frequency.value = 22050
          gain = ctx.createGain()
          analyser = ctx.createAnalyser()
          analyser.fftSize = 64
          analyser.smoothingTimeConstant = 0.72
          data = new Uint8Array(analyser.frequencyBinCount)
          src.connect(filter)
          filter.connect(gain)
          gain.connect(analyser)
          analyser.connect(ctx.destination)
          applyVolume()
          applyFilter()
          requestAnimationFrame(draw)
          return true
        } catch (e) {
          ctx = null
          degrade()
          return false
        }
      }

      function draw() {
        requestAnimationFrame(draw)
        if (!analyser || root.getAttribute('data-playing') !== 'true') return
        analyser.getByteFrequencyData(data)
        for (var i = 0; i < bars.length; i++) {
          var v = data[Math.floor((i * data.length) / bars.length)] / 255
          bars[i].style.transform = 'scaleY(' + Math.max(0.06, v) + ')'
        }
      }

      function applyVolume() {
        var v = Number(volIn ? volIn.value : 80) / 100
        if (gain) gain.gain.value = v
        else audio.volume = v
      }

      // One slider, detented in the middle: left rolls a low pass down, right
      // pushes a high pass up, centre stays out of the way.
      function applyFilter() {
        if (!filter || !filtIn) return
        var v = Number(filtIn.value)
        if (Math.abs(v) < 4) {
          filter.type = 'lowpass'
          filter.frequency.value = 22050
          if (filtOut) filtOut.textContent = 'Open'
          return
        }
        if (v < 0) {
          filter.type = 'lowpass'
          var lp = Math.round(22050 * Math.pow(200 / 22050, -v / 100))
          filter.frequency.value = lp
          if (filtOut) filtOut.textContent = lp >= 1000 ? (lp / 1000).toFixed(1) + 'k' : String(lp)
          return
        }
        filter.type = 'highpass'
        var hp = Math.round(20 * Math.pow(2000 / 20, v / 100))
        filter.frequency.value = hp
        if (filtOut) filtOut.textContent = hp >= 1000 ? (hp / 1000).toFixed(1) + 'k' : String(hp)
      }

      // The audio graph is only built from inside a real user gesture. An
      // AudioContext created before one stays suspended, and a media element
      // wired into a suspended context plays to nobody.
      function start(byUser) {
        wanted = true
        if (byUser) {
          buildGraph()
          if (ctx && ctx.state === 'suspended') ctx.resume()
        }
        var p = audio.play()
        if (p && p.catch) {
          p.catch(function () {
            wanted = false
            paint(false)
          })
        }
      }

      audio.addEventListener('play', function () {
        paint(true)
        remember({playing: true})
      })
      audio.addEventListener('pause', function () {
        if (switching) return // a song change, not the visitor pausing
        paint(false)
        remember({playing: false})
      })
      audio.addEventListener('timeupdate', function () {
        remember({position: audio.currentTime})
      })

      if (volIn) {
        volIn.addEventListener('input', function () {
          applyVolume()
          if (volOut) volOut.textContent = volIn.value
          remember({volume: Number(volIn.value)})
        })
      }
      if (filtIn) filtIn.addEventListener('input', applyFilter)

      button.addEventListener('click', function () {
        if (root.getAttribute('data-playing') === 'true') {
          wanted = false
          if (switching) {
            // Paused mid-change: drop the queued song start and the crackle.
            switching = false
            clearTimeout(swapTimer)
            if (stopCrackle) stopCrackle()
            stopCrackle = null
            paint(false)
            remember({playing: false})
          }
          audio.pause()
        } else {
          start(true)
        }
      })

      // Silent until the visitor presses play. Once they have, the music carries
      // on across pages for the rest of the visit.
      if (saved.playing === true) {
        start(false)
        // Picked up on a new page without a click, the music plays straight from
        // the element, outside the audio graph, so the filter and bars would be
        // dead. Wire the graph in on the visitor's first gesture, wherever it is.
        var wire = function () {
          buildGraph()
          if (ctx && ctx.state === 'suspended') ctx.resume()
          document.removeEventListener('pointerdown', wire, true)
          document.removeEventListener('keydown', wire, true)
        }
        document.addEventListener('pointerdown', wire, true)
        document.addEventListener('keydown', wire, true)
      }
    }

    /* ---------- SoundCloud embed: volume only ---------- */
    function embedMode() {
      var frame = root.querySelector('[data-sc]')
      if (typeof SC === 'undefined' || !SC.Widget) {
        root.hidden = true
        return
      }
      var widget = SC.Widget(frame)
      var playing = false

      widget.bind(SC.Widget.Events.READY, function () {
        widget.setVolume(Number(volIn ? volIn.value : 80))
        if (ticker && ticker.hidden) {
          widget.getCurrentSound(function (s) {
            if (s) setNowPlaying(s.user && s.user.username ? s.user.username + ' — ' + s.title : s.title)
          })
        }
        if (saved.position) widget.seekTo(saved.position)
        // Silent until the visitor presses play; carry on across pages once they have.
        if (saved.playing === true) widget.play()
      })

      widget.bind(SC.Widget.Events.PLAY, function () {
        playing = true
        paint(true)
        remember({playing: true})
      })
      widget.bind(SC.Widget.Events.PAUSE, function () {
        playing = false
        paint(false)
        remember({playing: false})
      })

      var last = 0
      widget.bind(SC.Widget.Events.PLAY_PROGRESS, function (e) {
        var now = Date.now()
        if (now - last < 1000) return
        last = now
        remember({position: e.currentPosition})
      })

      if (volIn) {
        volIn.addEventListener('input', function () {
          widget.setVolume(Number(volIn.value))
          if (volOut) volOut.textContent = volIn.value
          remember({volume: Number(volIn.value)})
        })
      }

      button.addEventListener('click', function () {
        if (playing) widget.pause()
        else widget.play()
      })
    }
  })()
</script>
