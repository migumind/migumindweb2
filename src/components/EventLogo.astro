---
// An event name drawn as a streetwear badge. Size follows the parent's
// font-size, so the same markup works as a globe pin label or a page title.

// Keep in sync with LOGO_STYLES in studio/schemaTypes/event.ts.
const LOGO_STYLES = ['script', 'stripe', 'bubble', 'property', 'pop', 'varsity', 'globe', 'block'] as const

interface Props {
  title: string
  style?: string
  /** Seeds the automatic style when none is picked in the studio. */
  seed?: string
  sub?: string
}

const {title, style, seed = title, sub} = Astro.props

let h = 0
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0
const v = style && (LOGO_STYLES as readonly string[]).includes(style) ? style : LOGO_STYLES[h % LOGO_STYLES.length]
---

<span class={`elogo elogo-${v}`}>
  {v === 'property' && <span class="pre">Property of</span>}
  <span class="name">{title}</span>
  {(v === 'property' || v === 'varsity') && <span class="post">{sub ?? 'Worldwide'}</span>}
  {(v === 'script' || v === 'pop' || v === 'bubble') && <sup class="mk">{v === 'script' ? '®' : '™'}</sup>}
  {v === 'varsity' && <span class="star" aria-hidden="true">★</span>}
</span>
