---
import '../styles/site.css'
import VinylPlayer from '../components/VinylPlayer.astro'
import SignupPopup from '../components/SignupPopup.astro'
import GridMenu from '../components/GridMenu.astro'
import {SIGNUP_ENABLED} from '../lib/shop'

interface Props {
  title: string
  description?: string
  section?: string
  /** Show the first-visit signup popup on this page (pages with their own form turn it off). */
  signupPopup?: boolean
}

const {
  title,
  description = 'Migu — artist and designer in Sydney. Painting, printmaking, live painting and graphic design. Artworks, exhibitions and studio archive.',
  section = '',
  signupPopup = true,
} = Astro.props

// Absolute URLs for metadata, driven by `site` in astro.config.mjs so the
// domain lives in exactly one place.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined
const ogImage = Astro.site ? new URL('og-image.png', Astro.site).href : '/og-image.png'

// The work first, then where it's shown, then the shop, then the person; contact last,
// where people look for it. (Studio lives in the footer.)
const NAV = [
  ['/artworks', 'Artworks', 'artworks'],
  ['/design', 'Graphic Design', 'design'],
  ['/exhibitions', 'Exhibitions', 'exhibitions'],
  ['/events', 'Events', 'events'],
  ['/shop', 'Shop', 'shop'],
  ['/about', 'About', 'about'],
  ['/contact', 'Contact', 'contact'],
]
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MIGUMIND" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F1EFE7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131511" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Martian+Mono:wght@300;400;500;700&family=Yellowtail&family=Reenie+Beanie&family=Noto+Sans+Tagalog&display=swap"
    />

    <script is:inline>
      // Applied before paint so the chosen theme does not flash on each page load.
      try {
        var t = localStorage.getItem('theme')
        if (t) document.documentElement.setAttribute('data-theme', t)
      } catch (e) {}
    </script>
  </head>

  <body>
    <header class="nav">
      <div class="navrow">
        <a href="/" class="brand">Migumind</a>
        <nav class="navlinks" id="navlinks">
          {
            NAV.map(([href, label, key]) => (
              <a href={href} class={section === key ? 'on' : ''}>
                {label}
              </a>
            ))
          }
        </nav>
        <div class="navtools">
          <button id="theme" type="button" aria-label="Toggle colour theme">Theme</button>
          <button id="burger" type="button" aria-expanded="false" aria-controls="menu-overlay">Menu</button>
        </div>
      </div>
    </header>

    <!-- Phones and tablets: the Menu button opens this grid in place of the row of links. -->
    <div class="gridoverlay" id="menu-overlay" hidden>
      <div class="gotop">
        <a href="/" class="brand">Migumind</a>
        <button class="chip" type="button" id="menu-close">Close ×</button>
      </div>
      <GridMenu id="sitemenu" section={section} inline />
    </div>

    <main>
      <slot />
    </main>

    <VinylPlayer />
    {SIGNUP_ENABLED && <SignupPopup show={signupPopup} />}

    <footer class="ft">
      <div class="fw">Migumind</div>
      <div class="ftcols">
        <div class="col">
          <h4>Work</h4>
          <a href="/artworks">Artworks</a>
          <a href="/exhibitions">Exhibitions</a>
          <a href="/events">Events + Live Painting</a>
          <a href="/studio">Studio</a>
        </div>
        <div class="col">
          <h4>Practice</h4>
          <a href="/about">About</a>
          <a href="/design">Graphic Design</a>
          <a href="/shop">Shop</a>
          <a href="/contact">Contact</a>
          <a href="/privacy">Privacy</a>
        </div>
        <div class="col">
          <h4>Elsewhere</h4>
          <a href="/contact">[INSTAGRAM]</a>
          <a href="mailto:migupaint@gmail.com">[EMAIL]</a>
        </div>
        <div class="col">
          <h4>Register</h4>
          <span class="m" style="color:#C7CABF">ARTIST / DESIGNER</span>
          <span class="m" style="color:#C7CABF">SYDNEY / AUSTRALIA</span>
          <span class="m" style="color:#C7CABF">MIGUMIND.COM</span>
        </div>
      </div>
      <div class="ftend m m11">
        <span class="reg"><i></i></span><span>MIGUMIND / 2026</span><span>INK / PAPER / SCREEN</span>
      </div>
    </footer>

    <script is:inline>
      ;(function () {
        var burger = document.getElementById('burger')
        var overlay = document.getElementById('menu-overlay')
        var closeBtn = document.getElementById('menu-close')
        function set(open) {
          overlay.hidden = !open
          burger.setAttribute('aria-expanded', String(open))
          document.documentElement.style.overflow = open ? 'hidden' : ''
          ;(open ? closeBtn : burger).focus()
        }
        burger.addEventListener('click', function () { set(true) })
        closeBtn.addEventListener('click', function () { set(false) })
        addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !overlay.hidden) set(false)
        })
        // Widening past the breakpoint swaps back to the row of links.
        matchMedia('(min-width: 901px)').addEventListener('change', function (m) {
          if (m.matches && !overlay.hidden) set(false)
        })
      })()

      document.getElementById('theme').addEventListener('click', function () {
        var r = document.documentElement
        var cur = r.getAttribute('data-theme')
        var dark = cur ? cur === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        var next = dark ? 'light' : 'dark'
        r.setAttribute('data-theme', next)
        try {
          localStorage.setItem('theme', next)
        } catch (e) {}
      })
    </script>
    <script is:inline>
      // Motion that plays on its own needs a way out (WCAG 2.2.2), and
      // reduced-motion users should not be given it at all.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[data-hero]').forEach(function (v) {
          v.autoplay = false
          v.loop = false
          // A background video has no business showing controls; it just holds on its poster.
          if (!v.hasAttribute('data-bg')) v.controls = true
          v.pause()
        })
      }
    </script>
  </body>
</html>
