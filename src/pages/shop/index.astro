      </figure>
      {
        collections.length > 0 && (
          <nav class="colnav" aria-label="Collections">
            {collections.map((c) => (
              <a class="chip" href={`#${c.handle}`}>
                {c.title} <span class="m">{String(c.products.length).padStart(2, '0')}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <div class="wrap">
      {
        collections.map((c) => (
          <section class="blk" id={c.handle}>
            <div class="sh">
              <div>
                <h2>{c.title}</h2>
              </div>
              <div class="r">
                <span class="m dimmer">{String(c.products.length).padStart(2, '0')} ITEMS</span>
                <a class="m dimmer" href={c.url}>IN THE STORE →</a>
              </div>
            </div>
            {c.products.length > 0 ? (
              <div class="grid12 products">
                {c.products.map((p) => (
                  <ProductCard product={p} />
                ))}
              </div>
            ) : (
              <p class="m dim">NOTHING HERE YET. JOIN THE LIST BELOW TO HEAR WHEN IT FILLS UP.</p>
            )}
          </section>
        ))
      }

      <section class="blk">
        <div class="gateway">
          <p class="body" style="margin:0;max-width:52ch">
            Prints and originals are sold through the Migumind store. Checkout, shipping and your
            order details are handled there.
          </p>
          <a class="cta" href={SHOP_URL}>Visit the store →</a>
        </div>
      </section>

      <section class="blk" id="print-club">
        <div class="sh">
          <div>
            <h2>Print club</h2>
            <Gloss tl="ka-pi-sa-na-n" en="society" />
          </div>
          <div class="r"><span class="m dimmer">WAITLIST</span></div>
        </div>
        <div class="split">
          <p class="lede">
            A limited print, made for members and posted to your door each cycle. Members also get
            first access to every drop.
          </p>
          {
            SIGNUP_ENABLED && (
              <div>
                <p class="m dim" style="margin:0 0 10px">JOIN THE WAITLIST — HEAR FIRST WHEN SPOTS OPEN</p>
                <SignupForm list="printclub" source="shop-printclub" button="Join the waitlist" />
              </div>
            )
          }
        </div>
      </section>

      {
        SIGNUP_ENABLED && (
          <section class="blk" id="drops" style="border-top:1px solid var(--rule)">
            <div class="sh">
              <div>
                <h2>Drops</h2>
                <Gloss tl="u-na sa ba-li-ta" en="first to hear" />
              </div>
            </div>
            <div class="split">
              <p class="lede">
                New prints come out in small drops. The list hears about them before anyone else.
              </p>
              <SignupForm source="shop-drops" />
            </div>
          </section>
        )
      }
    </div>
  </div>
</Base>
