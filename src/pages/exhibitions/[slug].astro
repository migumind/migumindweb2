---
import {PortableText} from 'astro-portabletext'
import Base from '../../layouts/Base.astro'
import ArtworkCard from '../../components/ArtworkCard.astro'
import HeroMedia from '../../components/HeroMedia.astro'
import {getArtworksByExhibition, getExhibitions, type Artwork, type Exhibition} from '../../lib/sanity'
import {ratioOf, urlFor} from '../../lib/image'

export async function getStaticPaths() {
  const exhibitions = await getExhibitions()
  return Promise.all(
    exhibitions.map(async (exhibition) => ({
      params: {slug: exhibition.slug},
      props: {exhibition, works: await getArtworksByExhibition(exhibition._id)},
    })),
  )
}

interface Props {
  exhibition: Exhibition
  works: Artwork[]
}

const {exhibition: e, works} = Astro.props
const bandColour = e.bandText === 'light' ? 'var(--fixed-paper)' : 'var(--fixed-ink)'
// Repeating 8/4/4/8 rhythm, matching the prototype's installation grid.
const INSTALL_WIDTHS = [8, 4, 4, 8]
// Installation shots, with any clips slotted in after every few images.
const clips = (e.videos ?? []).filter((v) => v.url)
const install: ({kind: 'photo'; img: NonNullable<Exhibition['installationImages']>[number]; n: number} | {kind: 'video'; src: string; n: number})[] = []
let ci = 0
;(e.installationImages ?? []).forEach((img, i) => {
  install.push({kind: 'photo', img, n: i + 1})
  if (i % 3 === 2 && ci < clips.length) install.push({kind: 'video', src: clips[ci].url!, n: ++ci})
})
while (ci < clips.length) install.push({kind: 'video', src: clips[ci].url!, n: ++ci})
---

<Base title={`${e.title} — Migumind`} section="exhibitions">
  <div class="page">
    <div class="band" style={`--accent:${e.accent};color:${bandColour}`}>
      <h1>{e.title}</h1>
      <span class="sub m m11">EXHIBITION_{e.number}<br />{e.year} · {e.location}</span>
    </div>

    {
      e.collaborators && (
        <div class="slashband">
          <span class="m">WITH {e.collaborators.toUpperCase()}</span>
          <span class="sl"></span>
          <span class="m">EXHIBITION_{e.number}</span>
        </div>
      )
    }

    <div class="wrap">
      <section class="blk">
        <div class="grid12">
          <div class="w8">
            {/* No hero picked yet: lead with the first installation shot rather than an empty frame. */}
            <HeroMedia image={e.heroImage ?? e.installationImages?.[0]} video={e.heroVideo} alt={e.title} width={1400} />
          </div>
          <div class="w4">
            {
              e.statement && e.statement.length > 0 && (
                <>
                  <div class="m dimmer" style="margin-bottom:10px">STATEMENT</div>
                  <div class="richtext" style="font-size:14px">
                    <PortableText value={e.statement} />
                  </div>
                </>
              )
            }
            <dl class="deflist">
              <div><dt>Dates</dt><dd>{e.dates ?? e.year}</dd></div>
              <div><dt>Location</dt><dd>{e.location}</dd></div>
              {e.collaborators && <div><dt>Collaborators</dt><dd>{e.collaborators}</dd></div>}
            </dl>
          </div>
        </div>
      </section>

      {
        install.length > 0 && (
          <section class="blk" style="border-top:1px solid var(--rule)">
            <div class="sh">
              <h2>Installation</h2>
              <div class="r"><span class="m dimmer">DOCUMENTATION</span></div>
            </div>
            <div class="grid12">
              {install.map((m, i) => (
                <div class={`w${m.kind === 'video' ? 4 : INSTALL_WIDTHS[i % INSTALL_WIDTHS.length]}`}>
                  {m.kind === 'photo' ? (
                    <span class="frame" style={`aspect-ratio:${ratioOf(m.img)}`}>
                      <img
                        src={urlFor(m.img).width(1200).fit('max').auto('format').url()}
                        alt={`${e.title} — installation ${m.n}`}
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="frame exclip" style="aspect-ratio:9/16">
                      <video data-hero src={m.src} muted loop playsinline autoplay preload="metadata" aria-label={`${e.title} — clip ${m.n}`} />
                    </span>
                  )}
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        e.note && e.note.length > 0 && (
          <section class="blk exnote" style="border-top:1px solid var(--rule)">
            <div class="sh">
              <h2>A note from Migu</h2>
              <div class="r"><span class="m dimmer">IN MY WORDS</span></div>
            </div>
            <div class="notecard">
              <div class="richtext">
                <PortableText value={e.note} />
              </div>
              <span class="sig">— migu.</span>
            </div>
          </section>
        )
      }

      {
        works.length > 0 && (
          <section class="blk" style="border-top:1px solid var(--rule)">
            <div class="sh">
              <h2>Works in this show</h2>
              <div class="r"><span class="m dimmer">{works.length} {works.length === 1 ? 'WORK' : 'WORKS'}</span></div>
            </div>
            <div class="grid12">
              {works.map((w) => <ArtworkCard artwork={w} width={4} />)}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Base>
