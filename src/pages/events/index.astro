---
import Base from '../../layouts/Base.astro'
import EventGlobe from '../../components/EventGlobe.astro'
import EventLogo from '../../components/EventLogo.astro'
import StickerWall from '../../components/StickerWall.astro'
import {formatDate, getEvents} from '../../lib/sanity'
import {resolveGeo} from '../../lib/cities'

const events = await getEvents()
const placed = events.map((e) => ({e, geo: resolveGeo(e)}))
const pins = placed
  .filter((p) => p.geo)
  .map(({e, geo}) => ({id: e._id, slug: e.slug, title: e.title, city: geo!.city, lat: geo!.lat, lng: geo!.lng, style: e.logoStyle}))
---

<Base title="Events + live painting — Migumind" section="events">
  <div class="page">
    <div class="band" style="--accent:var(--fluor);color:var(--fixed-ink)">
      <h1>Events<br />+ live painting</h1>
      <span class="sub m m11">
        {String(events.length).padStart(2, '0')} {events.length === 1 ? 'EVENT' : 'EVENTS'} / {
          String(new Set(pins.map((p) => p.city)).size).padStart(2, '0')
        } {new Set(pins.map((p) => p.city)).size === 1 ? 'CITY' : 'CITIES'}<br />MIGUMIND / 2026
      </span>
    </div>

    <section class="evstage">
      <StickerWall count={49} />
      <div class="evstage-globe">
        <EventGlobe pins={pins} />
      </div>
      <p class="evstage-hint m m11">Drag to spin — scroll or pinch to zoom — tap a pin</p>
    </section>

    <div class="wrap">
      <section class="blk">
        <div class="sh">
          <h2>All events</h2>
          <span class="m m11 dim">NEWEST FIRST</span>
        </div>

        {events.length === 0 && <p class="body">No events published yet.</p>}

        <ol class="evlist">
          {
            placed.map(({e, geo}, i) => (
              <li>
                <a href={`/events/${e.slug}`}>
                  <span class="no m m11 dimmer">{String(i + 1).padStart(2, '0')}</span>
                  <span class="lg">
                    <EventLogo title={e.title} style={e.logoStyle} seed={e.slug} />
                  </span>
                  <span class="meta m m11">
                    {e.date && <span>{formatDate(e.date)}</span>}
                    <span class="dim">{[e.location, !e.location?.toLowerCase().includes((geo?.city ?? '~').toLowerCase()) && geo?.city].filter(Boolean).join(' — ') || 'Location TBC'}</span>                  </span>
                  <span class="go" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</Base>
